diff --git a/lib/webgpu/web_extensions.cpp b/lib/webgpu/web_extensions.cpp
new file mode 100644
index 0000000..ba2a7ce
--- /dev/null
+++ b/lib/webgpu/web_extensions.cpp
@@ -0,0 +1,109 @@
+#include "web_extensions.hpp"
+#include "gpu.hpp"
+
+#include <aurora/webgpu.hpp>
+
+#include <SDL3/SDL_properties.h>
+#include <SDL3/SDL_video.h>
+#include <emscripten.h>
+
+#include <string>
+#include <vector>
+
+// `WebGPU` is the emdawnwebgpu runtime: getJsObject maps a handle to its GPU* object, and
+// importJs<Object> registers a JS object and returns a new handle that owns one reference.
+
+EM_JS(WGPUPipelineLayout, aurora_web_create_pipeline_layout,
+      (WGPUDevice device, const WGPUBindGroupLayout* layouts, uint32_t layoutCount, uint32_t immediateSize), {
+  const bindGroupLayouts = [];
+  for (let i = 0; i < layoutCount; ++i) {
+    bindGroupLayouts.push(WebGPU.getJsObject(HEAPU32[(layouts >> 2) + i]));
+  }
+  const layout = WebGPU.getJsObject(device).createPipelineLayout({bindGroupLayouts, immediateSize});
+  return WebGPU.importJsPipelineLayout(layout);
+});
+
+EM_ASYNC_JS(void, aurora_web_wait_for_animation_frame, (), {
+  await new Promise((resolve) => requestAnimationFrame(resolve));
+});
+
+EM_ASYNC_JS(void, aurora_web_yield_to_browser, (), {
+  // A MessageChannel round trip is a full task without setTimeout's minimum delay.
+  if (!globalThis.auroraYieldChannel) {
+    const channel = new MessageChannel();
+    globalThis.auroraYieldChannel = { port: channel.port2, waiters: [] };
+    channel.port1.onmessage = () => globalThis.auroraYieldChannel.waiters.shift()?.();
+  }
+  await new Promise((resolve) => {
+    globalThis.auroraYieldChannel.waiters.push(resolve);
+    globalThis.auroraYieldChannel.port.postMessage(0);
+  });
+});
+
+EM_JS(int, aurora_web_preferred_canvas_format_is_bgra, (), {
+  return navigator.gpu.getPreferredCanvasFormat() === 'bgra8unorm' ? 1 : 0;
+});
+
+EM_JS(void, aurora_web_set_immediates,
+      (WGPURenderPassEncoder pass, uint32_t offset, const void* data, uint32_t size), {
+  WebGPU.getJsObject(pass).setImmediates(offset, HEAPU8, data, size);
+});
+
+namespace aurora::webgpu::web {
+
+wgpu::PipelineLayout create_pipeline_layout(const wgpu::Device& device, const wgpu::PipelineLayoutDescriptor& desc) {
+  std::vector<WGPUBindGroupLayout> layouts(desc.bindGroupLayoutCount);
+  for (size_t i = 0; i < layouts.size(); ++i) {
+    layouts[i] = desc.bindGroupLayouts[i].Get();
+  }
+  return wgpu::PipelineLayout::Acquire(aurora_web_create_pipeline_layout(
+      device.Get(), layouts.data(), static_cast<uint32_t>(layouts.size()), desc.immediateSize));
+}
+
+void set_immediates(const wgpu::RenderPassEncoder& pass, uint32_t offset, const void* data, uint32_t size) {
+  aurora_web_set_immediates(pass.Get(), offset, data, size);
+}
+
+void yield_to_browser() { aurora_web_yield_to_browser(); }
+
+wgpu::TextureFormat preferred_canvas_format() {
+  // The spec allows only these two.
+  return aurora_web_preferred_canvas_format_is_bgra() ? wgpu::TextureFormat::BGRA8Unorm
+                                                      : wgpu::TextureFormat::RGBA8Unorm;
+}
+
+wgpu::Status present(const wgpu::Surface& surface) {
+  if (!surface) {
+    return wgpu::Status::Error;
+  }
+  aurora_web_wait_for_animation_frame();
+  return wgpu::Status::Success;
+}
+
+} // namespace aurora::webgpu::web
+
+namespace aurora::webgpu {
+
+// lib/webgpu/gpu_cache.cpp is Dawn's on-disk blob cache; browsers keep their own.
+void cache_prune() {}
+void cache_shutdown() {}
+
+// The window's canvas, as SDL3's Emscripten video driver reports it.
+wgpu::Surface create_window_surface(const wgpu::Instance& instance, SDL_Window* window, const char* label) {
+  if (!instance || window == nullptr) {
+    return nullptr;
+  }
+  const char* canvasId = SDL_GetStringProperty(SDL_GetWindowProperties(window),
+                                               SDL_PROP_WINDOW_EMSCRIPTEN_CANVAS_ID_STRING, "#canvas");
+  // SDL reports the CSS id selector ("#canvas"); accept a bare id too.
+  const std::string selector = canvasId[0] == '#' ? std::string(canvasId) : std::string("#") + canvasId;
+  wgpu::EmscriptenSurfaceSourceCanvasHTMLSelector canvas{};
+  canvas.selector = selector.c_str();
+  const wgpu::SurfaceDescriptor descriptor{
+      .nextInChain = &canvas,
+      .label = label,
+  };
+  return instance.CreateSurface(&descriptor);
+}
+
+} // namespace aurora::webgpu
